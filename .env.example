# Supabase — server-side Vercel API routes.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with VITE_ and must never be used in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-side fallback if you intentionally use RLS policies with the anon key.
SUPABASE_ANON_KEY=

# Existing legacy HQ/Neon integration (optional; retained for backwards compatibility).
DATABASE_URL=
ADMIN_TOKEN=

# Analytics / verification hooks. Leave blank until real IDs are available.
VITEGA4_ID=
VITEGTMID=
VITE_GOOGLE_SITE_VERIFICATION=
# Optional paid-media hooks. Leave blank until the real account IDs exist.
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
